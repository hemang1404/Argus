/* ========================================================================= */
/* Argus Terminal UI — docs-inspired terminal system                         */
/* Background #090a0d · surface #0d0f14 · border #252831 · text #e1e4ec      */
/* Accent #8188ff · warning #e88a13 · success #7bc79e · danger #e07178       */
/*                                                                           */
/* StartupScreen keeps its own original geometry and palette below.          */
/* ========================================================================= */

Screen {
    background: #090a0d;
    color: #e1e4ec;
    min-width: 80;
    min-height: 24;
}

/* 1. Global controls */
Button {
    background: transparent;
    color: #9298a8;
    border: none;
    height: 1;
    min-width: 10;
    padding: 0 1;
    margin-left: 1;
    content-align: center middle;
}

Button:hover {
    background: #12141b;
    color: #e1e4ec;
}

Button:focus {
    background: #161922;
    color: #8188ff;
    text-style: bold;
}

Button.-primary,
Button.-success {
    background: #8188ff;
    color: #090a0d;
    text-style: bold;
}

Button.-primary:hover,
Button.-success:hover {
    background: #9ba1ff;
    color: #090a0d;
}

Button.-primary:focus,
Button.-success:focus {
    background: #9ba1ff;
    color: #090a0d;
}

Button.-error {
    background: transparent;
    color: #e07178;
}

Button.-error:hover,
Button.-error:focus {
    background: #2a1518;
    color: #f08a90;
}

Button:disabled {
    opacity: 35%;
    color: #667085;
}

Input {
    background: #0b0d12;
    border: none;
    border-left: solid #252831;
    color: #e1e4ec;
    padding: 0 1;
    height: 1;
}

Input:focus {
    background: #0b0d12;
    border: none;
    border-left: solid #8188ff;
    color: #e1e4ec;
}

Input > .input--cursor {
    color: #8188ff;
    text-style: bold;
}

Input > .input--placeholder {
    color: #667085;
}

OptionList {
    background: #0b0d12;
    border: none;
    color: #9298a8;
    scrollbar-size-vertical: 1;
}

OptionList:focus {
    border: none;
}

OptionList > .option-list--option {
    padding: 0 1;
    height: 1;
}

OptionList > .option-list--option-highlighted {
    background: #1d2130;
    color: #8188ff;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: #161a24;
}

/* Scrollbars stay nearly invisible until needed. */
* {
    scrollbar-size-vertical: 1;
    scrollbar-background: transparent;
    scrollbar-color: #252831;
    scrollbar-color-hover: #5867a8;
    scrollbar-color-active: #8188ff;
}

/* 2. Status bar */
StatusBar {
    dock: bottom;
    width: 100%;
    height: 1;
    background: #08090d;
    color: #667085;
    padding: 0 2;
    border-top: none;
}

/* 3. Startup screen — unchanged geometry and palette */
StartupScreen {
    background: #08090d;
    color: #f8fafc;
    align: center middle;
}

#startup-outer {
    width: 100%;
    height: 100%;
    align: center middle;
}

#startup-center-unit {
    width: 76;
    height: auto;
    align: center middle;
}

#startup-hero {
    width: 76;
    height: auto;
    align: center middle;
    margin-bottom: 1;
}

#wordmark {
    width: 76;
    height: auto;
    max-height: 18;
    content-align: center middle;
}

#descriptor {
    display: none;
}

#command-box {
    width: 76;
    height: auto;
    background: #11131a;
    border: none;
    border-left: solid #818cf8;
    padding: 1 2;
}

#command-row-top {
    width: 100%;
    height: 1;
    align-vertical: middle;
    margin-bottom: 1;
}

#command-prompt-glyph {
    width: 2;
    height: 1;
    color: #818cf8;
    text-style: bold;
}

#command-input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 0;
}

#command-input:focus {
    border: none;
    background: transparent;
    color: #ffffff;
}

#command-row-bottom {
    width: 100%;
    height: 1;
    align-vertical: middle;
}

#sub-status {
    width: 1fr;
    height: 1;
    color: #64748b;
    text-align: left;
}

#key-hints {
    width: auto;
    height: 1;
    color: #64748b;
    text-align: right;
}

#startup-tip {
    width: 100%;
    height: 1;
    text-align: center;
    color: #64748b;
    margin-top: 1;
}

/* 4. Shared modal shell */
ModalScreen {
    align: center middle;
    background: #090a0d;
}

#palette-container,
#config-container,
#policy-container,
#doctor-container,
#usage-container,
#workflow-card,
#connect-container,
#stats-container,
#help-container,
#update-container {
    background: #0d0f14;
    border: solid #252831;
    border-top: solid #8188ff;
    padding: 1 2;
    height: auto;
}

/* Small uppercase context labels used by the new screens. */
.kicker {
    color: #8188ff;
    height: 1;
    text-style: bold;
}

.muted {
    color: #667085;
}

.modal-title {
    color: #e1e4ec;
    text-style: bold;
}

/* 5. Modal headers and footers */
.modal-header {
    width: 100%;
    height: 2;
    margin-bottom: 1;
}

.modal-heading {
    width: 1fr;
    height: auto;
}

.modal-status {
    width: auto;
    height: 1;
    color: #7bc79e;
    content-align: right top;
}

.modal-subtitle {
    color: #667085;
    margin-bottom: 1;
}

.modal-footer {
    width: 100%;
    height: 3;
    margin-top: 1;
    border-top: solid #1c1f27;
    padding-top: 1;
    align: right middle;
}

.modal-footer .footer-hint {
    width: 1fr;
    color: #667085;
}

.btn-row {
    width: 100%;
    height: 1;
    align: right middle;
    margin-top: 1;
}

/* 6. Session telemetry */
#stats-container {
    width: 70;
    max-width: 92%;
}

#stats-head {
    width: 100%;
    height: 2;
    margin-bottom: 1;
}

#stats-title {
    color: #e1e4ec;
    text-style: bold;
}

#stats-status {
    width: auto;
    color: #7bc79e;
    content-align: right top;
}

#stats-hero {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.stat-block {
    height: 3;
    padding-right: 2;
}

.stat-primary {
    width: 1fr;
}

.stat-secondary {
    width: 1fr;
}

.stat-label {
    color: #667085;
    height: 1;
}

.stat-value {
    color: #e1e4ec;
    text-style: bold;
    height: 1;
}

.stat-value.-blue {
    color: #8188ff;
}

.stat-unit {
    color: #667085;
    height: 1;
}

#stats-budget-bar {
    width: 100%;
    height: 1;
    color: #667085;
    margin-bottom: 1;
}

#stats-table {
    width: 100%;
    height: auto;
}

/* 7. Client integrations */
#connect-container {
    width: 78;
    max-width: 94%;
}

#connect-summary {
    width: 100%;
    height: 1;
    color: #667085;
    margin-bottom: 1;
}

#connect-table {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#connect-status-msg {
    width: 100%;
    height: auto;
    color: #7bc79e;
    margin-top: 1;
}

/* 8. Routing & escalation */
#policy-container {
    width: 80;
    max-width: 96%;
}

#policy-header {
    width: 100%;
    height: 2;
    margin-bottom: 1;
}

#policy-title {
    width: 1fr;
    color: #e1e4ec;
    text-style: bold;
}

#policy-esc {
    width: auto;
    color: #667085;
}

#policy-cards {
    width: 100%;
    height: 6;
    margin-bottom: 1;
}

.tier-card {
    width: 1fr;
    height: 6;
    background: #0b0d12;
    border: solid #1c1f27;
    padding: 0 1;
    margin: 0 1;
}

.tier-card:hover {
    border: solid #5867a8;
}

.tier-card.-selected {
    border: solid #5867a8;
    border-top: solid #8188ff;
    background: #12141b;
}

.tier-card-top {
    width: 100%;
    height: 1;
}

.tier-id {
    width: 3;
    color: #667085;
}

.tier-card-title {
    width: 1fr;
    color: #9298a8;
    text-style: bold;
}

.tier-card.-selected .tier-card-title {
    color: #e1e4ec;
}

.tier-check {
    width: auto;
    color: #8188ff;
}

.tier-card-model {
    height: 1;
    color: #9298a8;
}

.tier-card.-selected .tier-card-model {
    color: #e1e4ec;
}

.tier-card-note {
    height: 1;
    color: #667085;
}

#policy-fields {
    width: 100%;
    height: 4;
    margin-bottom: 1;
}

.policy-field {
    width: 1fr;
    height: 4;
    background: #0b0d12;
    border: solid #1c1f27;
    padding: 0 1;
    margin: 0 1;
}

.policy-field .field-label {
    height: 1;
    color: #667085;
    margin: 0;
}

.policy-field Input {
    width: 100%;
    height: 1;
    background: transparent;
    border: none;
    color: #e1e4ec;
    padding: 0;
    text-style: bold;
}

.policy-field Input:focus {
    background: transparent;
    border: none;
    color: #e1e4ec;
}

.policy-static-value {
    color: #9298a8;
    height: 1;
}

.policy-static-note {
    color: #667085;
    height: 1;
}

.kv-row {
    width: 100%;
    height: 1;
    align-vertical: middle;
    margin-top: 1;
}

.kv-label {
    width: 1fr;
    color: #9298a8;
    height: 1;
    content-align: left middle;
}

.kv-input {
    width: 24;
    height: 1;
    background: #0b0d12;
    border: none;
    border-left: solid #252831;
    color: #e1e4ec;
    text-align: right;
    text-style: bold;
    padding: 0 1;
}

.kv-input:focus {
    background: #0b0d12;
    border: none;
    border-left: solid #8188ff;
    color: #e1e4ec;
    text-style: bold;
}

.kv-static-val {
    width: auto;
    color: #e1e4ec;
    text-style: bold;
    height: 1;
    content-align: right middle;
}

#policy-key-hints {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #667085;
}

/* 9. Command palette */
#palette-container {
    width: 66;
    max-width: 92%;
    max-height: 24;
}

#palette-header {
    width: 100%;
    height: 2;
    margin-bottom: 1;
}

#palette-title {
    width: 1fr;
    color: #e1e4ec;
    text-style: bold;
}

#palette-count {
    width: auto;
    color: #667085;
    content-align: right top;
}

#palette-input {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border: solid #252831;
    color: #e1e4ec;
    margin-bottom: 1;
    padding: 0 1;
}

#palette-input:focus {
    border: solid #5867a8;
    background: #0b0d12;
    color: #e1e4ec;
}

#palette-options {
    width: 100%;
    max-height: 12;
    background: transparent;
    border: none;
    overflow-x: hidden;
}

#palette-footer {
    color: #667085;
    margin-top: 1;
    text-align: right;
}

/* 10. Execution timeline */
#exec-outer {
    width: 100%;
    height: 100%;
    background: #090a0d;
}

#exec-header-bar {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border-bottom: solid #1c1f27;
    padding: 0 2;
    align-vertical: middle;
}

#exec-header-title {
    width: 1fr;
    color: #e1e4ec;
    text-style: bold;
}

#exec-header-metrics {
    width: auto;
    color: #8188ff;
}

#exec-body {
    width: 100%;
    height: 1fr;
}

#exec-left-pane {
    width: 40%;
    height: 100%;
    background: #090a0d;
    border-right: solid #1c1f27;
    padding: 1 2;
    overflow-y: auto;
}

#exec-right-pane {
    width: 60%;
    height: 100%;
    background: #0d0f14;
    padding: 1 2;
    overflow-y: auto;
}

.hidden-pane {
    display: none;
}

.maximized-pane {
    width: 100%;
}

.pane-title {
    color: #667085;
    text-style: bold;
    margin-bottom: 1;
}

.event-entry {
    margin-bottom: 1;
    color: #e1e4ec;
}

#exec-actions-bar {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border-top: solid #1c1f27;
    padding: 0 2;
    align: right middle;
}

/* 11. Diff review */
#diff-outer {
    width: 100%;
    height: 1fr;
    background: #090a0d;
}

#diff-header-bar {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border-bottom: solid #1c1f27;
    padding: 1 2 0 2;
    align-vertical: middle;
}

#diff-feedback {
    display: none;
    background: #2a1518;
    color: #e07178;
    padding: 0 2;
    height: auto;
}

#diff-feedback.-active {
    display: block;
}

#diff-title {
    width: 1fr;
    color: #e1e4ec;
    text-style: bold;
}

#diff-status-badge {
    width: auto;
    color: #667085;
}

#diff-scroll-pane {
    width: 100%;
    height: 1fr;
    background: #090a0d;
    padding: 1 2;
}

#diff-empty-state {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#diff-empty-glyph-row {
    width: 100%;
    height: 3;
    align: center middle;
    margin-bottom: 1;
}

#diff-empty-glyph {
    width: 5;
    height: 3;
    border: solid #252831;
    color: #8188ff;
    background: #0b0d12;
    content-align: center middle;
}

#diff-empty-title {
    width: 100%;
    color: #e1e4ec;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#diff-empty-copy {
    width: 100%;
    color: #667085;
    text-align: center;
}

#diff-empty-command-row {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1 0;
}

#diff-empty-command {
    width: auto;
    height: 3;
    border-left: solid #8188ff;
    background: #0d0f14;
    color: #9298a8;
    padding: 1 1;
}

#diff-empty-note {
    width: 100%;
    padding: 0 12;
    color: #667085;
    text-align: center;
}

#diff-empty-flow {
    width: 100%;
    color: #5867a8;
    text-align: center;
    margin-top: 1;
}

#diff-actions-bar {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border-top: solid #1c1f27;
    padding: 0 2;
    align: right middle;
}

#diff-actions-bar Button {
    margin-left: 1;
}

DiffViewer {
    width: 100%;
    height: auto;
    background: #090a0d;
    padding: 0 1;
}

/* 12. Guided recovery workflow */
#workflow-outer {
    width: 100%;
    height: 100%;
    background: #090a0d;
    align: center middle;
}

#workflow-card {
    width: 74;
    max-width: 92%;
    height: auto;
}

#workflow-header-row {
    width: 100%;
    height: 2;
    margin-bottom: 0;
}

#workflow-card-title {
    width: 1fr;
    color: #e1e4ec;
    text-style: bold;
}

#workflow-esc {
    width: auto;
    color: #667085;
    content-align: right top;
}

#workflow-card-subtitle {
    color: #667085;
    margin-bottom: 1;
}

.workflow-field-label {
    color: #667085;
    height: 1;
    margin-top: 1;
}

.workflow-field-label .required {
    width: 1fr;
    color: #9298a8;
    text-align: right;
}

/* The name column hugs its text; a 1fr label would push the meta column
   past the row's right edge, where it gets clipped. */
.workflow-field-label Static {
    width: auto;
}

.workflow-input {
    width: 100%;
    height: 3;
    background: #0b0d12;
    border: solid #1c1f27;
    color: #e1e4ec;
    padding: 0 1;
}

.workflow-input:focus {
    border: solid #5867a8;
    background: #0b0d12;
    color: #e1e4ec;
}

#context-info {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#workflow-guardrail {
    width: 100%;
    height: 1;
    color: #667085;
    margin-top: 1;
}

#workflow-actions-bar {
    width: 100%;
    height: 3;
    align: right middle;
    margin-top: 1;
    border-top: solid #1c1f27;
    padding-top: 1;
}

/* 13. Generic modal titles and fields */
#doctor-content {
    margin-bottom: 1;
    max-height: 16;
}

#doctor-title,
#config-title,
#usage-title {
    color: #e1e4ec;
    text-style: bold;
    margin-bottom: 1;
}

#config-container {
    width: 76;
    max-width: 94%;
    height: auto;
}

#config-container.config-mode-budget,
#config-container.config-mode-attempts {
    width: 58;
    max-width: 90%;
}

.config-mode-budget #config-input,
.config-mode-attempts #config-input {
    width: 24;
    margin-bottom: 1;
}

#config-container.config-mode-tier {
    width: 70;
    max-width: 92%;
}

#config-provider-status {
    width: 100%;
    height: 2;
    background: #0b0d12;
    border-left: solid #252831;
    color: #9298a8;
    padding: 0 1;
    margin-bottom: 1;
}

#config-prompt {
    color: #667085;
    margin-bottom: 1;
}

.field-head {
    width: 100%;
    height: 1;
    margin-top: 1;
}

.field-head .field-label {
    width: 1fr;
    margin-top: 0;
}

.field-head .field-meta {
    width: auto;
    color: #667085;
}

.field-label {
    color: #667085;
    margin-top: 1;
    margin-bottom: 0;
}

#config-field-note {
    color: #667085;
    margin-top: 0;
    margin-bottom: 1;
}

#config-options {
    height: 6;
    background: #0b0d12;
    border: none;
    border-left: solid #252831;
    margin-bottom: 1;
}

#config-input,
#config-api-key {
    background: #0b0d12;
    border: none;
    border-left: solid #252831;
    color: #e1e4ec;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

#config-input:focus,
#config-api-key:focus {
    border: none;
    border-left: solid #8188ff;
    background: #0b0d12;
    color: #e1e4ec;
}

#config-error {
    width: 100%;
    height: 1;
    color: #e07178;
    margin-top: 1;
    text-align: center;
}

#connect-container {
    width: 78;
    max-width: 94%;
}

#doctor-container {
    width: 74;
    max-width: 92%;
    height: auto;
}

#help-container {
    width: 74;
    max-width: 92%;
    height: auto;
}

#update-container {
    width: 74;
    max-width: 92%;
    height: auto;
}

#usage-container {
    width: 58;
    max-width: 90%;
    height: auto;
}

#stats-container {
    width: 70;
    max-width: 92%;
}

/* 14. Rich renderables inside Static */
#stats-table,
#connect-table {
    margin-bottom: 1;
}
