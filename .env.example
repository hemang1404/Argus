# Argus Environment Configuration Template (.env.example)
# Copy this file to .env and configure your keys.
# NEVER commit your real .env file or private credentials to git.

# =============================================================================
# 1. Supported Inference Providers
# =============================================================================

# Official OpenAI API (for gpt-4o, gpt-4o-mini, o3-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude Sonnet, Claude Opus via Gateway or OpenRouter)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# 2. Antigravity Host Native CLI (Recommended - Zero API Keys Required)
# =============================================================================
# Host Native inference uses your local authenticated Google Antigravity session ('agy').
# No environment variables or API keys are required when using Antigravity Host Native.
# The CLI will automatically use your existing host login.
#
# To verify host authentication:
#   agy auth list
#   argus doctor

# =============================================================================
# 3. Optional Local Runtimes (Zero Cost / Offline)
# =============================================================================
# Ollama / LM Studio local OpenAI-compatible endpoints require no API key:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1

# =============================================================================
# 4. Experimental Gateway Proxy (Optional)
# =============================================================================
# Required only when running the local reverse proxy ('argus serve' or 'argus gateway')
# ARGUS_GATEWAY_API_KEY=your_secure_random_gateway_bearer_token
