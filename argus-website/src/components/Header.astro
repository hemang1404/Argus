---
import { topNav, normalizePath, topNavKey, repoUrl } from '../data/nav.mjs';
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';

// Self-hosted variable fonts — no network requests at runtime.
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';

const { starlightRoute } = Astro.locals;
const path = normalizePath(Astro.url.pathname);
const activeKey = topNavKey(path);
const hasSidebar = Boolean(starlightRoute?.hasSidebar);
---

<div class="argus-header">
  <a class="argus-brand" href="/" aria-label="Argus documentation home">
    <Wordmark title="Argus" />
  </a>

  <nav class="top-links" aria-label="Primary">
    {
      topNav.map((link) => (
        <a
          href={link.href}
          aria-current={activeKey === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="header-right">
    <Search />
    <a
      class="icon-link"
      href={repoUrl}
      target="_blank"
      rel="noreferrer noopener"
      aria-label="Argus on GitHub"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span>GitHub</span>
    </a>
    {
      hasSidebar && (
        <button
          class="menu-btn"
          type="button"
          aria-controls="starlight__sidebar"
          aria-expanded="false"
          aria-label="Open documentation navigation"
        >
          <svg class="open-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M2 4.5h12M2 8h12M2 11.5h12" stroke-linecap="round" />
          </svg>
          <svg class="close-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round" />
          </svg>
        </button>
      )
    }
  </div>
</div>

<script>
  // The site header owns the mobile menu trigger. Starlight's sidebar pane is
  // controlled by `aria-expanded` state, so mirror that state onto the nav.
  const menuBtn = document.querySelector<HTMLButtonElement>('.argus-header .menu-btn');
  if (menuBtn) {
    const nav = document.querySelector<HTMLElement>('.page > nav.sidebar');
    const setOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close documentation navigation' : 'Open documentation navigation');
      nav?.setAttribute('aria-expanded', String(open));
      document.body.toggleAttribute('data-mobile-menu-expanded', open);
    };

    menuBtn.addEventListener('click', () => {
      setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuBtn.focus();
      }
    });

    document.querySelectorAll('#starlight__sidebar a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.matchMedia('(min-width: 50rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Add a language bar to code fences that do not carry a filename title.
  // Expressive Code renders a title bar only when `title` is supplied; the
  // language is otherwise available as `data-language` on the <pre> element.
  for (const frame of document.querySelectorAll<HTMLElement>('.expressive-code figure.frame')) {
    const pre = frame.querySelector<HTMLPreElement>('pre[data-language]');
    const language = pre?.dataset.language;
    if (!pre || !language || !pre.parentElement) continue;

    // Expressive Code emits an empty, zero-height header for the copy control
    // even when no filename is set. Skip only frames that carry a real title.
    const header = frame.querySelector<HTMLElement>('figcaption.header');
    if (header?.textContent?.trim()) continue;

    const bar = document.createElement('div');
    bar.className = 'argus-code-bar';
    const label = document.createElement('span');
    label.textContent = language;
    bar.append(label);
    pre.parentElement.insertBefore(bar, pre);
    frame.classList.add('argus-has-bar');
  }
</script>

<script is:inline>
  // Non-Mac keyboards should see Ctrl rather than the command glyph.
  if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
    document.querySelectorAll('[data-search-mod]').forEach((el) => {
      el.textContent = 'Ctrl';
    });
  }
</script>
