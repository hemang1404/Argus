---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
  children?: TocItem[];
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<ul>
  {
    items.map((item) => (
      <li>
        <a href={`#${item.slug}`}>{item.text}</a>
        {item.children && item.children.length > 0 && <Astro.self items={item.children} />}
      </li>
    ))
  }
</ul>
