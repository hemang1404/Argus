    <script>
      const screenOrder = [
        'home',
        'stats',
        'connect',
        'model',
        'policy',
        'commands',
        'diff',
        'recovery',
      ];
      const panels = Array.from(document.querySelectorAll('[data-screen]'));
      const tabs = Array.from(document.querySelectorAll('[data-screen-target]'));
      const commandSearch = document.querySelector('[data-command-search]');
      const commandRows = Array.from(document.querySelectorAll('[data-command-row]'));
      const commandGroups = Array.from(document.querySelectorAll('[data-command-group]'));
      const commandCount = document.querySelector('[data-command-count]');
      let currentScreen = 'home';

      function showScreen(name) {
        if (!screenOrder.includes(name)) return;
        currentScreen = name;
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.screen !== name;
        });
        tabs.forEach((tab) => {
          const selected = tab.dataset.screenTarget === name;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        if (window.location.hash !== `#${name}`) {
          history.replaceState(null, '', `#${name}`);
        }
        if (name === 'commands' && commandSearch) {
          commandSearch.value = '';
          filterCommands('');
          window.setTimeout(() => commandSearch.focus(), 40);
        }
      }

      function filterCommands(query) {
        const needle = query.trim().toLowerCase();
        let visible = 0;
        commandRows.forEach((row) => {
          const match = !needle || row.dataset.search.includes(needle);
          row.hidden = !match;
          if (match) visible += 1;
        });
        commandGroups.forEach((group) => {
          const rows = group.querySelectorAll('[data-command-row]');
          group.hidden = Array.from(rows).every((row) => row.hidden);
        });
        if (commandCount) {
          commandCount.textContent = `${visible} ${visible === 1 ? 'result' : 'results'}`;
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => showScreen(tab.dataset.screenTarget));
      });

      document.querySelectorAll('[data-close]').forEach((button) => {
        button.addEventListener('click', () => showScreen('home'));
      });

      commandRows.forEach((row) => {
        row.addEventListener('click', () => {
          if (row.dataset.target) showScreen(row.dataset.target);
        });
      });

      if (commandSearch) {
        commandSearch.addEventListener('input', () => {
          filterCommands(commandSearch.value);
        });
        commandSearch.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            const first = commandRows.find((row) => !row.hidden);
            if (first) first.focus();
          }
        });
      }

      document.addEventListener('keydown', (event) => {
        const isTyping =
          event.target instanceof HTMLElement &&
          (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA');

        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          showScreen('commands');
          return;
        }

        if (event.key === 'Escape') {
          if (currentScreen !== 'home') {
            event.preventDefault();
            showScreen('home');
          }
          return;
        }

        if (isTyping) return;

        const index = Number(event.key) - 1;
        if (index >= 0 && index < screenOrder.length) {
          showScreen(screenOrder[index]);
        }
      });

      const initial = window.location.hash.replace('#', '');
      showScreen(screenOrder.includes(initial) ? initial : 'home');

      window.addEventListener('hashchange', () => {
        const next = window.location.hash.replace('#', '');
        if (screenOrder.includes(next) && next !== currentScreen) showScreen(next);
      });
    </script>

