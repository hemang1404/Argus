---
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import Wordmark from '../components/Wordmark.astro';
import Mark from '../components/Mark.astro';

const repoUrl = 'https://github.com/hemang1404/Argus';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="A design study of the Argus terminal interface. The startup screen is unchanged; the surrounding modals are redesigned."
    />
    <title>Argus TUI — Interface study</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Argus documentation">
        <Wordmark class="brand-wordmark" />
      </a>
      <span class="crumb">/ TUI redesign</span>
      <div class="header-actions">
        <span class="preview-badge">Design study</span>
        <a href="/interfaces/tui/">TUI docs</a>
        <a href={repoUrl} rel="noreferrer" target="_blank">GitHub</a>
      </div>
    </header>

    <main class="page">
      <section class="intro">
        <div>
          <p class="eyebrow">Interface study · terminal cockpit</p>
          <h1>The same cockpit, sharpened.</h1>
          <p class="lede">
            The startup screen stays exactly as it is. The screens around it — telemetry,
            integrations, provider, policy, commands, diff, and recovery setup — get the
            docs treatment: quieter surfaces, a clearer reading order, and one consistent
            action language. Every field, status, and shortcut from the current TUI is
            preserved.
          </p>
        </div>
        <div class="intro-meta">
          <span>8 screens</span>
          <span>Startup unchanged</span>
          <span>Runtime untouched</span>
        </div>
      </section>

      <section class="workbench" aria-label="TUI redesign preview">
        <aside class="screen-nav">
          <div class="nav-head">
            <span>Screens</span>
            <span>01—08</span>
          </div>

          <button
            class="screen-tab"
            type="button"
            id="tab-home"
            role="tab"
            aria-controls="screen-home"
            aria-selected="true"
            data-screen-target="home"
          >
            <span class="tab-number">01</span>
            <span class="tab-copy">
              <span class="tab-name">Home</span>
              <span class="tab-hint">prompt · policy</span>
            </span>
            <span class="tab-flag">unchanged</span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-stats"
            role="tab"
            aria-controls="screen-stats"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="stats"
          >
            <span class="tab-number">02</span>
            <span class="tab-copy">
              <span class="tab-name">Telemetry</span>
              <span class="tab-hint">spend · gateway</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-connect"
            role="tab"
            aria-controls="screen-connect"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="connect"
          >
            <span class="tab-number">03</span>
            <span class="tab-copy">
              <span class="tab-name">Integrations</span>
              <span class="tab-hint">clients · layers</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-model"
            role="tab"
            aria-controls="screen-model"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="model"
          >
            <span class="tab-number">04</span>
            <span class="tab-copy">
              <span class="tab-name">Model</span>
              <span class="tab-hint">provider · key</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-policy"
            role="tab"
            aria-controls="screen-policy"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="policy"
          >
            <span class="tab-number">05</span>
            <span class="tab-copy">
              <span class="tab-name">Policy</span>
              <span class="tab-hint">tier · budget</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-commands"
            role="tab"
            aria-controls="screen-commands"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="commands"
          >
            <span class="tab-number">06</span>
            <span class="tab-copy">
              <span class="tab-name">Commands</span>
              <span class="tab-hint">search · actions</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-diff"
            role="tab"
            aria-controls="screen-diff"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="diff"
          >
            <span class="tab-number">07</span>
            <span class="tab-copy">
              <span class="tab-name">Diff</span>
              <span class="tab-hint">empty state</span>
            </span>
          </button>

          <button
            class="screen-tab"
            type="button"
            id="tab-recovery"
            role="tab"
            aria-controls="screen-recovery"
            aria-selected="false"
            tabindex="-1"
            data-screen-target="recovery"
          >
            <span class="tab-number">08</span>
            <span class="tab-copy">
              <span class="tab-name">Recovery</span>
              <span class="tab-hint">test · target</span>
            </span>
          </button>

          <div class="nav-note">
            <span>Keys</span>
            <span><kbd>1</kbd>–<kbd>8</kbd> switch · <kbd>ctrl K</kbd> commands</span>
          </div>
        </aside>

        <div class="stage">
          <div class="terminal">
            <!-- HOME / UNCHANGED -->
            <section
              class="screen-page home-page"
              id="screen-home"
              role="tabpanel"
              aria-labelledby="tab-home"
              data-screen="home"
            >
              <div class="home-inner">
                <Wordmark class="home-wordmark" />
                <div class="command-box">
                  <div class="command-row">
                    <span class="prompt-mark">❯</span>
                    <span class="command-placeholder"
                      >Run test command... "pytest tests/test_calculator.py" or "/" for
                      commands...</span
                    >
                    <span class="terminal-caret" aria-hidden="true"></span>
                  </div>
                  <div class="command-sub">
                    <span class="command-context"
                      >Recover <i>·</i> <strong>argus/auto</strong> <i>·</i> $0.03 cap</span
                    >
                    <span class="command-keys"
                      ><kbd>tab</kbd> policy <kbd>ctrl+p</kbd> commands</span
                    >
                  </div>
                </div>
                <p class="home-tip">
                  <span class="orange-dot"></span>
                  <strong>Tip</strong> Run <code>/connect</code> to link Cursor, Claude
                  Code, or Aider
                </p>
              </div>
            </section>

            <!-- STATS -->
            <section
              class="screen-page modal-page"
              id="screen-stats"
              role="tabpanel"
              aria-labelledby="tab-stats"
              data-screen="stats"
              hidden
            >
              <div class="modal modal-stats">
                <header class="modal-head">
                  <div>
                    <p class="kicker">Session</p>
                    <h2 class="modal-title">Telemetry &amp; cost</h2>
                  </div>
                  <span class="status-chip is-ok"><span class="dot"></span> gateway ready</span>
                </header>

                <div class="stat-hero">
                  <div class="stat-primary">
                    <span class="stat-label">Session spend</span>
                    <strong class="stat-value">$0.0000</strong>
                    <span class="stat-unit">USD</span>
                  </div>
                  <div class="stat-secondary">
                    <span class="stat-label">Budget limit</span>
                    <strong>$0.03</strong>
                    <span class="stat-unit">USD</span>
                  </div>
                  <div class="stat-secondary">
                    <span class="stat-label">Cost savings rate</span>
                    <strong class="is-blue">Adaptive</strong>
                    <span class="stat-unit">tiering active</span>
                  </div>
                </div>

                <div class="budget-track" aria-hidden="true"><span></span></div>
                <div class="budget-caption">
                  <span>$0.0300 remaining</span>
                  <span>0% of session cap</span>
                </div>

                <div class="info-list">
                  <div class="info-row">
                    <span>Gateway</span>
                    <span class="info-value"
                      ><code>127.0.0.1:8000/v1</code><span class="inline-status is-ok"
                        ><span class="dot"></span> Ready</span
                      ></span
                    >
                  </div>
                  <div class="info-row">
                    <span>Active client</span>
                    <span class="info-value">Listening for inbound SDK/agent traffic</span>
                  </div>
                  <div class="info-row">
                    <span>Quick setup</span>
                    <span class="info-value"
                      >Type <code>/connect</code> in the TUI, or run
                      <code>argus init aider</code> / <code>argus setup</code> to link your
                      IDE.</span
                    >
                  </div>
                </div>

                <footer class="modal-foot">
                  <span class="foot-hint"><kbd>esc</kbd> close</span>
                  <div class="actions">
                    <button class="tui-btn" type="button" data-close>
                      Close <kbd>esc</kbd>
                    </button>
                  </div>
                </footer>
              </div>
            </section>

            <!-- CONNECT -->
            <section
              class="screen-page modal-page"
              id="screen-connect"
              role="tabpanel"
              aria-labelledby="tab-connect"
              data-screen="connect"
              hidden
            >
              <div class="modal modal-connect">
                <header class="modal-head">
                  <div>
                    <p class="kicker">Clients</p>
                    <h2 class="modal-title">Client integrations</h2>
                    <p class="modal-sub">
                      Argus auto-detects installed coding agents and IDEs. Connect them
                      here — no terminal configuration or JSON editing required.
                    </p>
                  </div>
                  <span class="status-chip"><span class="dot"></span> 3 connected</span>
                </header>

                <div class="client-summary">
                  <span class="inline-status is-ok"><span class="dot"></span> 3 connected</span>
                  <span class="inline-status is-warn"><span class="dot"></span> 2 ready</span>
                  <span class="inline-status"><span class="dot"></span> 2 not detected</span>
                </div>

                <div class="client-table">
                  <div class="client-head">
                    <span>Client / tool</span>
                    <span>System status</span>
                    <span>Integration layer</span>
                  </div>

                  <div class="client-group">
                    <span>Connected</span>
                    <span>3</span>
                  </div>
                  <div class="client-row">
                    <span class="client-name">Antigravity IDE &amp; CLI</span>
                    <span class="inline-status is-ok"><span class="dot"></span> Connected</span>
                    <span class="client-layer">MCP Tools + Inference Gateway</span>
                  </div>
                  <div class="client-row">
                    <span class="client-name">OpenCode</span>
                    <span class="inline-status is-ok"><span class="dot"></span> Connected</span>
                    <span class="client-layer">MCP Tools + Inference Gateway</span>
                  </div>
                  <div class="client-row">
                    <span class="client-name">Gemini CLI</span>
                    <span class="inline-status is-ok"><span class="dot"></span> Connected</span>
                    <span class="client-layer">MCP Tools</span>
                  </div>

                  <div class="client-group">
                    <span>Ready to connect</span>
                    <span>2</span>
                  </div>
                  <div class="client-row">
                    <span class="client-name">Cursor IDE</span>
                    <span class="inline-status is-warn"
                      ><span class="dot"></span> Ready to connect</span
                    >
                    <span class="client-layer">MCP Tools + Inference Gateway</span>
                  </div>
                  <div class="client-row">
                    <span class="client-name">Claude Code CLI</span>
                    <span class="inline-status is-warn"
                      ><span class="dot"></span> Ready to connect</span
                    >
                    <span class="client-layer">Inference Gateway</span>
                  </div>

                  <div class="client-group">
                    <span>Not detected</span>
                    <span>2</span>
                  </div>
                  <div class="client-row is-muted">
                    <span class="client-name">Aider CLI</span>
                    <span class="inline-status"><span class="dot"></span> Not detected</span>
                    <span class="client-layer">Inference Gateway</span>
                  </div>
                  <div class="client-row is-muted">
                    <span class="client-name">Continue Extension</span>
                    <span class="inline-status"><span class="dot"></span> Not detected</span>
                    <span class="client-layer">Inference Gateway</span>
                  </div>
                </div>

                <footer class="modal-foot">
                  <span class="foot-hint"><kbd>c</kbd> connect all available</span>
                  <div class="actions">
                    <button class="tui-btn" type="button" data-close>
                      Close <kbd>esc</kbd>
                    </button>
                    <button class="tui-btn is-primary" type="button">
                      Connect all <kbd>c</kbd>
                    </button>
                  </div>
                </footer>
              </div>
            </section>

            <!-- MODEL -->
            <section
              class="screen-page modal-page"
              id="screen-model"
              role="tabpanel"
              aria-labelledby="tab-model"
              data-screen="model"
              hidden
            >
              <div class="modal modal-model">
                <header class="modal-head">
                  <div>
                    <p class="kicker">Provider</p>
                    <h2 class="modal-title">Inference model</h2>
                  </div>
                  <span class="status-chip is-ok"><span class="dot"></span> host ready</span>
                </header>

                <div class="provider-banner">
                  <div>
                    <span class="micro-label">Active provider</span>
                    <strong>Antigravity Host Native</strong>
                    <p>Zero external API keys required.</p>
                  </div>
                  <span class="provider-mode">HOST</span>
                </div>

                <div class="field">
                  <div class="field-head">
                    <span class="micro-label">Model</span>
                    <span class="field-meta">3 available</span>
                  </div>
                  <div class="model-list" role="listbox" aria-label="Available models">
                    <div class="model-row" role="option" aria-selected="false">
                      <span class="radio" aria-hidden="true"></span>
                      <code class="model-id">gemini-3.8-flash-high</code>
                      <span class="model-desc">Deep reasoning</span>
                      <span class="model-flag">ready</span>
                    </div>
                    <div class="model-row is-selected" role="option" aria-selected="true">
                      <span class="radio is-on" aria-hidden="true"></span>
                      <code class="model-id">gemini-3.8-flash-medium</code>
                      <span class="model-desc">Balanced · fast</span>
                      <span class="model-flag is-blue">selected</span>
                    </div>
                    <div class="model-row" role="option" aria-selected="false">
                      <span class="radio" aria-hidden="true"></span>
                      <code class="model-id">gemini-3.8-flash-low</code>
                      <span class="model-desc">Ultra-fast</span>
                      <span class="model-flag">ready</span>
                    </div>
                  </div>
                </div>

                <div class="form-grid">
                  <label class="field">
                    <span class="micro-label">Custom model ID</span>
                    <span class="tui-input"
                      ><span class="input-prompt">❯</span
                      ><input
                        type="text"
                        value="gemini-3.8-flash-medium"
                        aria-label="Custom model ID"
                        spellcheck="false"
                    /></span>
                  </label>
                  <label class="field">
                    <span class="micro-label">Provider API key <em>optional</em></span>
                    <span class="tui-input"
                      ><span class="input-prompt">›</span
                      ><input
                        type="password"
                        placeholder="Leave blank to keep current secret"
                        aria-label="Provider API key"
                    /></span>
                  </label>
                </div>
                <p class="field-note">
                  Saved securely to the OS keyring. Host-native models need no key.
                </p>

                <footer class="modal-foot">
                  <span class="foot-hint"><kbd>↑</kbd><kbd>↓</kbd> select</span>
                  <div class="actions">
                    <button class="tui-btn" type="button" data-close>
                      Cancel <kbd>esc</kbd>
                    </button>
                    <button class="tui-btn is-primary" type="button">
                      Apply <kbd>↵</kbd>
                    </button>
                  </div>
                </footer>
              </div>
            </section>

            <!-- POLICY -->
            <section
              class="screen-page modal-page"
              id="screen-policy"
              role="tabpanel"
              aria-labelledby="tab-policy"
              data-screen="policy"
              hidden
            >
              <div class="modal modal-policy">
                <header class="modal-head">
                  <div>
                    <p class="kicker">Routing</p>
                    <h2 class="modal-title">Escalation policy</h2>
                  </div>
                  <span class="status-chip">auto available</span>
                </header>

                <div class="tier-grid">
                  <div class="tier-card is-selected">
                    <div class="tier-top">
                      <span class="tier-id">T1</span>
                      <span class="tier-name">Fast</span>
                      <span class="tier-check">●</span>
                    </div>
                    <code class="tier-model">gemini-3.8-flash</code>
                    <span class="tier-note">Lowest cost · first attempt</span>
                  </div>
                  <div class="tier-card">
                    <div class="tier-top">
                      <span class="tier-id">T2</span>
                      <span class="tier-name">Strong</span>
                      <span class="tier-check"></span>
                    </div>
                    <code class="tier-model">claude-sonnet-4-6</code>
                    <span class="tier-note">Balanced escalation</span>
                  </div>
                  <div class="tier-card">
                    <div class="tier-top">
                      <span class="tier-id">T3</span>
                      <span class="tier-name">Frontier</span>
                      <span class="tier-check"></span>
                    </div>
                    <code class="tier-model">claude-opus-4-6</code>
                    <span class="tier-note">Deepest repair attempts</span>
                  </div>
                </div>

                <div class="policy-fields">
                  <label class="field-box">
                    <span class="micro-label">Budget ceiling</span>
                    <span class="value-input"
                      ><span>$</span><input value="0.03" aria-label="Budget ceiling" /><em
                        >USD</em
                      ></span
                    >
                  </label>
                  <label class="field-box">
                    <span class="micro-label">Max attempts</span>
                    <span class="value-input"
                      ><input value="3" aria-label="Max attempts" /><em>turns</em></span
                    >
                  </label>
                  <div class="field-box is-readout">
                    <span class="micro-label">Sandbox</span>
                    <span class="readout-value">git worktree</span>
                    <span class="readout-note">isolated from the working tree</span>
                  </div>
                </div>

                <footer class="modal-foot">
                  <span class="foot-hint">
                    <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> pin tier · <kbd>a</kbd> auto
                  </span>
                  <div class="actions">
                    <button class="tui-btn" type="button" data-close>
                      Cancel <kbd>esc</kbd>
                    </button>
                    <button class="tui-btn is-primary" type="button">
                      Apply <kbd>↵</kbd>
                    </button>
                  </div>
                </footer>
              </div>
            </section>

            <!-- COMMANDS -->
            <section
              class="screen-page modal-page"
              id="screen-commands"
              role="tabpanel"
              aria-labelledby="tab-commands"
              data-screen="commands"
              hidden
            >
              <div class="modal modal-commands">
                <header class="palette-head">
                  <span>Commands</span>
                  <span class="palette-count" data-command-count>10 results</span>
                </header>

                <label class="command-search">
                  <span class="search-prefix">❯ /</span>
                  <input
                    type="text"
                    placeholder="Type a command…"
                    aria-label="Search commands"
                    autocomplete="off"
                    spellcheck="false"
                    data-command-search
                  />
                  <kbd>esc</kbd>
                </label>

                <div class="command-list">
                  <div class="command-group" data-command-group>
                    <span class="command-group-label">Run</span>
                    <button
                      class="command-row is-active"
                      type="button"
                      data-command-row
                      data-search="recover run repair test loop"
                      data-target="recovery"
                    >
                      <code>/recover</code>
                      <span>Run test-gated code repair loop</span>
                      <kbd>↵</kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="diff review apply candidate patch"
                      data-target="diff"
                    >
                      <code>/diff</code>
                      <span>Review and apply candidate diff</span>
                      <kbd>d</kbd>
                    </button>
                  </div>

                  <div class="command-group" data-command-group>
                    <span class="command-group-label">Configure</span>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="policy routing tier budget"
                      data-target="policy"
                    >
                      <code>/policy</code>
                      <span>Configure routing tier &amp; budget</span>
                      <kbd>p</kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="model provider api key"
                      data-target="model"
                    >
                      <code>/model</code>
                      <span>Configure LLM provider &amp; API key</span>
                      <kbd>m</kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="connect link ide cursor claude aider"
                      data-target="connect"
                    >
                      <code>/connect</code>
                      <span>Link local IDEs (Cursor, Claude, Aider)</span>
                      <kbd>c</kbd>
                    </button>
                  </div>

                  <div class="command-group" data-command-group>
                    <span class="command-group-label">Inspect</span>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="stats token spend savings telemetry"
                      data-target="stats"
                    >
                      <code>/stats</code>
                      <span>View token spend &amp; alpha savings</span>
                      <kbd>s</kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="doctor diagnostics health check"
                    >
                      <code>/doctor</code>
                      <span>Run system diagnostics &amp; health check</span>
                      <kbd></kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="help keybindings cheat sheet"
                    >
                      <code>/help</code>
                      <span>Show keybindings &amp; cheat sheet</span>
                      <kbd>?</kbd>
                    </button>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="clear stream history"
                    >
                      <code>/clear</code>
                      <span>Clear session routing stream history</span>
                      <kbd></kbd>
                    </button>
                  </div>

                  <div class="command-group" data-command-group>
                    <span class="command-group-label">System</span>
                    <button
                      class="command-row"
                      type="button"
                      data-command-row
                      data-search="quit exit daemon"
                    >
                      <code>/quit</code>
                      <span>Exit Argus daemon</span>
                      <kbd>q</kbd>
                    </button>
                  </div>
                </div>

                <footer class="palette-foot">
                  <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
                  <span><kbd>↵</kbd> select</span>
                  <span><kbd>esc</kbd> close</span>
                </footer>
              </div>
            </section>

            <!-- DIFF -->
            <section
              class="screen-page diff-page"
              id="screen-diff"
              role="tabpanel"
              aria-labelledby="tab-diff"
              data-screen="diff"
              hidden
            >
              <header class="diff-header">
                <div>
                  <p class="kicker">Diff</p>
                  <h2 class="modal-title">No pending patches</h2>
                </div>
                <span class="status-chip">○ no pending diff</span>
              </header>

              <div class="diff-body">
                <div class="empty-state">
                  <div class="empty-glyph" aria-hidden="true">±</div>
