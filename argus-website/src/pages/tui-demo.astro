        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 53px;
        padding: 10px 20px;
        border-top: 1px solid var(--line-soft);
      }

      .foot-hint {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
      }

      .actions {
        display: flex;
        flex: 0 0 auto;
        gap: 6px;
      }

      .tui-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        height: 29px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 2px;
        background: var(--raised-2);
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 10px;
        cursor: pointer;
        transition:
          border-color 140ms ease,
          background 140ms ease,
          color 140ms ease;
      }

      .tui-btn:hover {
        border-color: #343848;
        background: #1a1d26;
        color: var(--text);
      }

      .tui-btn kbd {
        border-color: transparent;
        background: transparent;
        color: var(--text-3);
        padding: 0;
        min-width: 0;
        height: auto;
        font-size: 8px;
      }

      .tui-btn.is-primary {
        border-color: var(--blue);
        background: var(--blue);
        color: #090a0d;
        font-weight: 600;
      }

      .tui-btn.is-primary:hover {
        border-color: #9ca2ff;
        background: #9ca2ff;
      }

      .tui-btn.is-primary kbd {
        color: rgba(9, 10, 13, 0.6);
        font-weight: 600;
      }

      .stat-hero {
        display: grid;
        grid-template-columns: 1.35fr 0.8fr 0.9fr;
        gap: 18px;
        align-items: end;
        padding: 0 20px 12px;
      }

      .stat-primary,
      .stat-secondary {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 7px;
      }

      .stat-primary {
        flex-direction: column;
        gap: 2px;
        align-items: flex-start;
      }

      .stat-label,
      .micro-label {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .stat-value {
        color: var(--text);
        font-family: var(--mono);
        font-size: 34px;
        font-weight: 450;
        letter-spacing: -0.045em;
        line-height: 1;
      }

      .stat-secondary strong {
        color: var(--text);
        font-family: var(--mono);
        font-size: 15px;
        font-weight: 500;
      }

      .stat-secondary strong.is-blue {
        color: var(--blue);
      }

      .stat-unit {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
      }

      .budget-track {
        height: 2px;
        margin: 0 20px;
        overflow: hidden;
        background: var(--line-soft);
      }

      .budget-track span {
        display: block;
        width: 0;
        height: 100%;
        background: var(--blue);
      }

      .budget-caption {
        display: flex;
        justify-content: space-between;
        padding: 6px 20px 12px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
      }

      .info-list {
        border-top: 1px solid var(--line-soft);
      }

      .info-row {
        display: grid;
        grid-template-columns: 125px minmax(0, 1fr);
        gap: 16px;
        align-items: baseline;
        padding: 10px 20px;
        border-bottom: 1px solid var(--line-soft);
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 10px;
      }

      .info-row:last-child {
        border-bottom: 0;
      }

      .info-value {
        display: flex;
        flex-wrap: wrap;
        gap: 5px 10px;
        align-items: baseline;
        color: var(--text-2);
        line-height: 1.5;
      }

      .info-value code {
        color: var(--text-2);
        font-size: 10px;
      }

      .inline-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
        white-space: nowrap;
      }

      .inline-status.is-ok {
        color: var(--green);
      }

      .inline-status.is-warn {
        color: var(--orange);
      }

      .client-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        padding: 0 20px 12px;
      }

      .client-table {
        border-top: 1px solid var(--line-soft);
      }

      .client-head,
      .client-row {
        display: grid;
        grid-template-columns: 1.25fr 0.9fr 1.35fr;
        gap: 14px;
        align-items: baseline;
        padding: 7px 20px;
      }

      .client-head {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .client-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 20px 5px;
        border-top: 1px solid var(--line-soft);
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .client-group span:last-child {
        color: var(--text-3);
        letter-spacing: 0;
      }

      .client-row {
        min-height: 30px;
        border-bottom: 1px solid rgba(28, 31, 39, 0.7);
        font-family: var(--mono);
        font-size: 10px;
      }

      .client-row:last-child {
        border-bottom: 0;
      }

      .client-name {
        color: var(--text-2);
      }

      .client-layer {
        overflow: hidden;
        color: var(--text-3);
        font-size: 9px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .client-row.is-muted .client-name {
        color: var(--text-3);
      }

      .client-row.is-muted .client-layer {
        color: #4e5665;
      }

      .provider-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin: 0 20px 15px;
        padding: 10px 12px;
        border: 1px solid var(--line-soft);
        background: #0b0d12;
      }

      .provider-banner > div {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 7px;
      }

      .provider-banner strong {
        color: var(--text);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 500;
      }

      .provider-banner p {
        width: 100%;
        margin: 1px 0 0;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
      }

      .provider-mode {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.12em;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .modal-model > .field {
        margin: 0 20px;
      }

      .field-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
      }

      .field-meta {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
      }

      .micro-label em {
        color: var(--text-3);
        font-style: normal;
        letter-spacing: 0;
        text-transform: none;
      }

      .model-list {
        border: 1px solid var(--line-soft);
        background: #0b0d12;
      }

      .model-row {
        display: grid;
        grid-template-columns: 14px minmax(0, 1.4fr) minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
        min-height: 32px;
        padding: 0 11px;
        border-bottom: 1px solid var(--line-soft);
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 10px;
      }

      .model-row:last-child {
        border-bottom: 0;
      }

      .model-row.is-selected {
        background: var(--blue-soft);
        box-shadow: inset 2px 0 0 var(--blue);
      }

      .radio {
        width: 7px;
        height: 7px;
        border: 1px solid #3a4050;
        border-radius: 50%;
      }

      .radio.is-on {
        border-color: var(--blue);
        background: var(--blue);
        box-shadow: 0 0 0 2px rgba(129, 136, 255, 0.12);
      }

      .model-id {
        color: var(--text-2);
        font-size: 10px;
      }

      .model-row.is-selected .model-id {
        color: var(--text);
      }

      .model-desc {
        color: var(--text-3);
        font-size: 9px;
      }

      .model-flag {
        color: var(--text-3);
        font-size: 8px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .model-flag.is-blue {
        color: var(--blue);
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin: 13px 20px 0;
      }

      .tui-input {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 30px;
        padding: 0 9px;
        border: 1px solid var(--line-soft);
        background: #0b0d12;
      }

      .tui-input:focus-within {
        border-color: var(--blue-deep);
      }

      .input-prompt {
        color: var(--blue);
        font-family: var(--mono);
        font-size: 9px;
      }

      .tui-input input {
        width: 100%;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 10px;
      }

      .tui-input input::placeholder {
        color: var(--text-3);
      }

      .tui-input.is-large {
        min-height: 34px;
      }

      .tui-input.is-large input {
        font-size: 11px;
      }

      .field-note {
        margin: 0;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
        line-height: 1.5;
      }

      .modal-model > .field-note {
        margin: 8px 20px 0;
      }

      .tier-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 0 20px 15px;
      }

      .tier-card {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
        padding: 11px;
        border: 1px solid var(--line-soft);
        background: #0b0d12;
      }

      .tier-card.is-selected {
        border-color: var(--blue-deep);
        background: var(--blue-soft);
        box-shadow: inset 0 2px 0 var(--blue);
      }

      .tier-top {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .tier-id {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.08em;
      }

      .tier-name {
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 500;
      }

      .tier-check {
        margin-left: auto;
        color: var(--blue);
        font-family: var(--mono);
        font-size: 8px;
      }

      .tier-model {
        overflow: hidden;
        color: var(--text-2);
        font-size: 10px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .tier-card.is-selected .tier-model {
        color: var(--text);
      }

      .tier-note {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        line-height: 1.5;
      }

      .policy-fields {
        display: grid;
        grid-template-columns: 0.95fr 0.8fr 1.15fr;
        gap: 10px;
        padding: 0 20px 15px;
      }

      .field-box {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 9px 10px;
        border: 1px solid var(--line-soft);
        background: #0b0d12;
      }

      .value-input {
        display: flex;
        align-items: baseline;
        gap: 5px;
      }

      .value-input span,
      .value-input em {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
        font-style: normal;
      }

      .value-input input {
        width: 100%;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-family: var(--mono);
        font-size: 18px;
        letter-spacing: -0.02em;
      }

      .readout-value {
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 11px;
      }

      .readout-note {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
      }

      .modal-commands {
        max-width: 620px;
      }

      .palette-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px 10px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .palette-count {
        color: var(--text-3);
        font-size: 9px;
        letter-spacing: 0;
        text-transform: none;
      }

      .command-search {
        display: flex;
        align-items: center;
        gap: 7px;
        min-height: 37px;
        margin: 0 14px 10px;
        padding: 0 10px;
        border: 1px solid var(--blue-deep);
        background: #0b0d12;
      }

      .search-prefix {
        color: var(--blue);
        font-family: var(--mono);
        font-size: 9px;
        white-space: nowrap;
      }

      .command-search input {
        width: 100%;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-family: var(--mono);
        font-size: 11px;
      }

      .command-search input::placeholder {
        color: var(--text-3);
      }

      .command-search kbd {
        flex: 0 0 auto;
      }

      .command-list {
        max-height: 405px;
        overflow-y: auto;
        padding: 0 6px 4px;
      }

      .command-group {
        padding-top: 4px;
      }

      .command-group-label {
        display: block;
        padding: 5px 8px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .command-row {
        display: grid;
        grid-template-columns: 68px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        width: 100%;
        min-height: 28px;
        padding: 3px 8px;
        border: 1px solid transparent;
        border-radius: 2px;
        background: transparent;
        text-align: left;
        cursor: pointer;
      }

      .command-row:hover {
        background: rgba(255, 255, 255, 0.02);
      }

      .command-row.is-active {
        border-color: rgba(129, 136, 255, 0.13);
        background: var(--blue-soft);
      }

      .command-row code {
        color: var(--blue);
        font-size: 10px;
      }

      .command-row span {
        overflow: hidden;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 10px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .command-row kbd {
        justify-self: end;
        border-color: transparent;
        background: transparent;
        padding: 0;
        min-width: 0;
        height: auto;
        color: var(--text-3);
      }

      .palette-foot {
        display: flex;
        gap: 16px;
        padding: 9px 14px;
        border-top: 1px solid var(--line-soft);
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
      }

      .palette-foot kbd {
        height: 15px;
        min-width: 15px;
        margin-right: 3px;
        font-size: 7px;
      }

      .diff-page {
        display: flex;
        flex-direction: column;
      }

      .diff-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 76px;
        padding: 15px 20px 13px;
        border-bottom: 1px solid var(--line);
      }

      .diff-body {
        display: grid;
        flex: 1;
        place-items: center;
        padding: 30px 20px;
      }

      .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(540px, 100%);
        text-align: center;
      }

      .empty-glyph {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 17px;
        border: 1px solid var(--line);
        border-radius: 2px;
        background: #0b0d12;
        color: var(--blue);
        font-family: var(--mono);
        font-size: 18px;
      }

      .empty-state h3 {
        margin: 0;
        color: var(--text);
        font-family: var(--mono);
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.01em;
      }

      .empty-state > p {
        margin: 7px 0 0;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 10px;
        line-height: 1.6;
      }

      .empty-command {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 315px;
        margin-top: 18px;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-left: 2px solid var(--blue);
        background: var(--raised);
        text-align: left;
      }

      .empty-command code {
        flex: 1;
        color: var(--text-2);
        font-size: 10px;
      }

      .empty-command kbd {
        border-color: transparent;
        background: transparent;
        padding: 0;
        min-width: 0;
      }

      .empty-note {
        max-width: 460px;
        margin-top: 18px;
        color: var(--text-3) !important;
        font-size: 9.5px !important;
        line-height: 1.7 !important;
      }

      .diff-flow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 22px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .diff-flow span {
        display: flex;
        gap: 5px;
        align-items: baseline;
      }

      .diff-flow b {
        color: var(--blue-deep);
        font-weight: 400;
      }

      .diff-flow i {
        color: #3e4552;
        font-style: normal;
      }

      .diff-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 52px;
        padding: 9px 20px;
        border-top: 1px solid var(--line-soft);
      }

      .modal-recovery .modal-head {
        padding-bottom: 13px;
      }

      .esc-hint {
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 8px;
        white-space: nowrap;
      }

      .recovery-fields {
        display: flex;
        flex-direction: column;
        gap: 13px;
        padding: 0 20px;
      }

      .runtime-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        margin: 15px 20px 0;
        border: 1px solid var(--line-soft);
        background: var(--line-soft);
      }

      .runtime-bar > div {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
        padding: 8px 9px;
        background: #0b0d12;
      }

      .runtime-bar strong {
        overflow: hidden;
        color: var(--text-2);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 500;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .guardrail {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 11px 20px 0;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
      }

      .guardrail-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--green);
      }

      .modal-recovery .modal-foot {
        margin-top: 14px;
      }

      .stage-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 9px;
        color: var(--text-3);
        font-family: var(--mono);
        font-size: 9px;
      }

      .notes {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        margin-top: 52px;
        border-top: 1px solid var(--line-soft);
        border-bottom: 1px solid var(--line-soft);
        background: var(--line-soft);
      }

      .note {
        padding: 20px 17px 22px;
        background: var(--bg);
      }

      .note-number {
        color: var(--blue);
        font-family: var(--mono);
        font-size: 8px;
      }

      .note h3 {
        margin: 12px 0 7px;
        color: var(--text);
        font-size: 12px;
        font-weight: 530;
        letter-spacing: -0.01em;
      }

      .note p {
        margin: 0;
        color: var(--text-3);
        font-size: 10px;
        line-height: 1.7;
      }

      .note.is-boundary {
        border-left: 1px solid var(--line-soft);
      }

      .note.is-boundary strong {
        color: var(--orange);
        font-family: var(--mono);
        font-size: 8px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .note.is-boundary p {
        margin-top: 12px;
      }

      @media (max-width: 1120px) {
        .workbench {
          grid-template-columns: 190px minmax(0, 1fr);
          gap: 16px;
        }

        .terminal {
          min-height: 680px;
        }

        .modal-page {
          padding: 22px;
        }

        .tier-grid {
          gap: 7px;
        }

        .tier-card {
          padding: 9px;
        }
      }

      @media (max-width: 900px) {
        .intro {
          grid-template-columns: 1fr;
          gap: 18px;
        }

        .intro-meta {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: flex-start;
        }

        .workbench {
          grid-template-columns: 1fr;
        }

        .screen-nav {
          position: static;
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 3px;
          padding: 8px;
        }

        .nav-head,
        .nav-note {
          display: none;
        }

        .screen-tab {
          grid-template-columns: 18px minmax(0, 1fr);
          gap: 2px 5px;
          padding: 7px 6px;
          border-left: 1px solid transparent;
          border-bottom: 2px solid transparent;
        }

        .screen-tab[aria-selected='true'] {
          border-left-color: transparent;
          border-bottom-color: var(--blue);
        }

        .tab-number {
          grid-row: auto;
          font-size: 7px;
        }

        .tab-copy {
          gap: 1px;
        }

        .tab-name {
          font-size: 10px;
        }

        .tab-hint {
          font-size: 7px;
        }

        .tab-flag {
          display: none;
        }

        .terminal {
          min-height: 660px;
        }

        .modal-page {
          padding: 18px;
        }

        .modal {
          max-width: 100%;
        }
      }

      @media (max-width: 720px) {
        .site-header {
          height: 56px;
          padding: 0 16px;
        }

        .brand-wordmark {
          width: 68px;
        }

        .crumb,
        .preview-badge {
          display: none;
        }

        .header-actions {
          gap: 13px;
        }

        .page {
          padding: 34px 14px 54px;
        }

        .intro h1 {
          font-size: 2.2rem;
        }

        .lede {
          font-size: 12px;
        }

        .screen-nav {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .terminal {
          min-height: 620px;
        }

        .home-page {
          padding: 28px 16px;
        }

        .home-wordmark {
          width: 60%;
          margin-bottom: 32px;
        }

        .command-placeholder {
          font-size: 8px;
        }

        .command-sub {
          flex-direction: column;
          align-items: flex-start;
          gap: 5px;
          padding: 7px 12px;
        }

        .command-keys {
          font-size: 8px;
        }

        .modal-page {
          place-items: start center;
          padding: 12px;
        }

        .modal {
          margin: auto 0;
        }

        .modal-head {
          gap: 12px;
          padding: 15px 14px 12px;
        }

        .modal-title {
          font-size: 15px;
        }

        .modal-sub {
          font-size: 9px;
        }

        .modal-foot {
          flex-wrap: wrap;
          gap: 9px;
          padding: 9px 14px;
        }

        .actions {
          margin-left: auto;
        }

        .stat-hero {
          grid-template-columns: 1fr 1fr;
          gap: 12px;
          padding: 0 14px 12px;
        }

        .stat-primary {
          grid-column: 1 / -1;
        }

        .budget-track,
        .info-row {
          margin-right: 14px;
          margin-left: 14px;
        }

        .budget-caption {
          padding-right: 14px;
          padding-left: 14px;
        }

        .info-row {
          grid-template-columns: 95px minmax(0, 1fr);
          gap: 10px;
          padding-right: 0;
          padding-left: 0;
        }

        .client-summary,
        .tier-grid,
        .policy-fields,
        .recovery-fields {
          padding-right: 14px;
          padding-left: 14px;
        }

        .client-head,
        .client-row {
          grid-template-columns: 1.2fr 0.95fr;
          gap: 8px;
          padding-right: 14px;
          padding-left: 14px;
        }

        .client-head span:nth-child(3),
        .client-layer {
          display: none;
        }

        .client-group {
          padding-right: 14px;
          padding-left: 14px;
        }

        .provider-banner {
          margin-right: 14px;
          margin-left: 14px;
        }

        .field,
        .modal-model > .field {
          margin-right: 14px;
          margin-left: 14px;
        }

        .model-row {
          grid-template-columns: 14px minmax(0, 1fr) auto;
        }

        .model-desc {
          display: none;
        }

        .form-grid {
          grid-template-columns: 1fr;
          margin-right: 14px;
          margin-left: 14px;
        }

        .tier-grid,
        .policy-fields {
          grid-template-columns: 1fr;
        }

        .runtime-bar {
          grid-template-columns: 1fr 1fr;
          margin-right: 14px;
          margin-left: 14px;
        }

        .guardrail {
          margin-right: 14px;
          margin-left: 14px;
        }

        .modal-recovery .modal-head,
        .modal-model > .field-note {
          margin-right: 0;
          margin-left: 0;
        }

        .command-search {
          margin-right: 10px;
          margin-left: 10px;
        }

        .command-row {
          grid-template-columns: 62px minmax(0, 1fr) auto;
          gap: 7px;
        }

        .diff-header {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
          padding: 14px;
        }

        .diff-body {
          padding: 22px 14px;
        }

        .empty-command {
          min-width: 0;
          width: 100%;
        }

        .diff-foot {
          padding: 9px 14px;
        }

        .diff-flow {
          gap: 6px;
          font-size: 6px;
        }

        .notes {
          grid-template-columns: 1fr 1fr;
          margin-top: 34px;
        }

        .note.is-boundary {
          border-left: 0;
        }

        .stage-foot {
          align-items: flex-start;
          flex-direction: column;
          gap: 4px;
        }
      }

      @media (max-width: 480px) {
        .header-actions a:last-child {
          display: none;
        }

        .intro-meta {
          font-size: 7px;
        }

        .screen-nav {
          grid-template-columns: 1fr 1fr;
        }

        .tab-hint {
          display: none;
        }

        .terminal {
          min-height: 610px;
        }

        .home-wordmark {
          width: 72%;
        }

        .command-row {
          min-height: 40px;
        }

        .command-placeholder {
          white-space: normal;
          line-height: 1.5;
        }

        .statusbar {
          padding: 0 10px;
          font-size: 8px;
        }

        .stat-hero {
          grid-template-columns: 1fr;
        }

        .stat-primary {
          grid-column: auto;
        }

        .client-head,
        .client-row {
          grid-template-columns: 1fr auto;
        }

        .client-head span:nth-child(2) {
          display: none;
        }

        .client-layer {
          display: none;
        }

        .model-row {
          grid-template-columns: 12px minmax(0, 1fr) auto;
        }

        .modal-foot {
          align-items: flex-start;
          flex-direction: column;
        }

        .actions {
          width: 100%;
          justify-content: flex-end;
          margin-left: 0;
        }

        .runtime-bar {
          grid-template-columns: 1fr;
        }

        .notes {
          grid-template-columns: 1fr;
        }

        .diff-flow i {
          display: none;
        }

        .diff-flow {
          flex-wrap: wrap;
          justify-content: center;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
